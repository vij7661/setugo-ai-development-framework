{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setugo.example/schemas/governance-r8/v15-r1/guard-omission-source-evidence.schema.json",
  "title": "R8 v15-r1 Guard Omission Source Evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "r8-v15-r1-guard-omission-source-evidence/v1"
    },
    "status": {
      "const": "REVIEW_EVIDENCE_NON_AUTHORITATIVE"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "semantic_candidate_commit": {
      "const": "c721b38cf8b00294797300b526596ce723a47ff8"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "digest_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "text_encoding": {
          "const": "UTF-8"
        },
        "line_separator": {
          "const": "LF"
        },
        "trailing_line_separator_added": {
          "const": false
        },
        "digest_field": {
          "const": "raw_section_sha256"
        },
        "verification_instruction": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "algorithm",
        "text_encoding",
        "line_separator",
        "trailing_line_separator_added",
        "digest_field",
        "verification_instruction"
      ]
    },
    "record_count": {
      "const": 11
    },
    "all_guard_sets_equal": {
      "const": true
    },
    "all_case_sets_equal": {
      "const": true
    },
    "records": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_version": {
            "type": "string",
            "pattern": "^v\\d+$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_commit": {
            "type": "string",
            "minLength": 1
          },
          "source_blob": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "digest_basis": {
            "type": "string",
            "minLength": 1
          },
          "raw_section_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "raw_section_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "parsed_guard_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^G\\d{3}$"
            }
          },
          "parsed_case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^V\\d+-\\d{3}$"
            }
          },
          "manifest_guard_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^G\\d{3}$"
            }
          },
          "manifest_case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^V\\d+-\\d{3}$"
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "guard_set_equal": {
                "const": true
              },
              "case_set_equal": {
                "const": true
              },
              "missing_guard_ids": {
                "type": "array",
                "maxItems": 0
              },
              "extra_guard_ids": {
                "type": "array",
                "maxItems": 0
              },
              "missing_case_ids": {
                "type": "array",
                "maxItems": 0
              },
              "extra_case_ids": {
                "type": "array",
                "maxItems": 0
              }
            },
            "required": [
              "guard_set_equal",
              "case_set_equal",
              "missing_guard_ids",
              "extra_guard_ids",
              "missing_case_ids",
              "extra_case_ids"
            ]
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_version",
          "source_path",
          "source_commit",
          "source_blob",
          "line_start",
          "line_end",
          "digest_basis",
          "raw_section_sha256",
          "raw_section_bytes",
          "parsed_guard_ids",
          "parsed_case_ids",
          "manifest_guard_ids",
          "manifest_case_ids",
          "verification",
          "excerpt"
        ]
      }
    }
  },
  "required": [
    "schema",
    "status",
    "authority_effect",
    "semantic_candidate_commit",
    "purpose",
    "digest_contract",
    "record_count",
    "all_guard_sets_equal",
    "all_case_sets_equal",
    "records"
  ],
  "x-governance-source": [
    "NORM-042",
    "H-1 evidence closure"
  ]
}
