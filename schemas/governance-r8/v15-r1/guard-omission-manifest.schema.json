{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setugo.example/schemas/governance-r8/v15-r1/guard-omission-manifest.schema.json",
  "title": "R8 v15-r1 Guard Omission Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "guard-omission-manifest-1/v3"
    },
    "status": {
      "const": "REVIEW_EVIDENCE_NON_AUTHORITATIVE"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "current_guard_registry": {
      "type": "object"
    },
    "current_case_registry": {
      "type": "object"
    },
    "omitted_table_count": {
      "const": 11
    },
    "invalid_omission_count": {
      "const": 0
    },
    "validation_contract": {
      "type": "object"
    },
    "omitted_tables": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_version": {
            "type": "string",
            "pattern": "^v\\d+$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_commit": {
            "type": "string",
            "minLength": 1
          },
          "source_blob": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "raw_section_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "raw_section_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "guard_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^G\\d{3}$"
            }
          },
          "referenced_case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^V\\d+-\\d{3}$"
            }
          },
          "parsed_source_guard_set_equals_manifest_set": {
            "const": true
          },
          "parsed_source_case_set_equals_manifest_set": {
            "const": true
          },
          "all_guard_ids_in_current_registry": {
            "const": true
          },
          "all_referenced_case_ids_in_current_case_registry": {
            "const": true
          },
          "missing_guard_ids": {
            "type": "array",
            "maxItems": 0
          },
          "extra_guard_ids": {
            "type": "array",
            "maxItems": 0
          },
          "missing_case_ids": {
            "type": "array",
            "maxItems": 0
          },
          "extra_case_ids": {
            "type": "array",
            "maxItems": 0
          },
          "evidence_record_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "source_version",
          "source_path",
          "source_commit",
          "source_blob",
          "line_start",
          "line_end",
          "raw_section_sha256",
          "raw_section_bytes",
          "guard_ids",
          "referenced_case_ids",
          "parsed_source_guard_set_equals_manifest_set",
          "parsed_source_case_set_equals_manifest_set",
          "all_guard_ids_in_current_registry",
          "all_referenced_case_ids_in_current_case_registry",
          "missing_guard_ids",
          "extra_guard_ids",
          "missing_case_ids",
          "extra_case_ids",
          "evidence_record_index"
        ]
      }
    },
    "reverification": {
      "type": "object"
    },
    "legacy_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "status",
    "authority_effect",
    "current_guard_registry",
    "current_case_registry",
    "omitted_table_count",
    "invalid_omission_count",
    "validation_contract",
    "omitted_tables",
    "reverification",
    "legacy_note"
  ],
  "x-governance-source": [
    "NORM-042",
    "H-1 evidence closure"
  ]
}
