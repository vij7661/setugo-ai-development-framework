{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setugo.example/schemas/governance-r8/v15-r1/srtt-4-rule-registry.schema.json",
  "title": "R8 v15-r1 SRTT-4 RuleRegistry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "r8-v15-srtt-4-rule-registry/v1"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "authority_effect": {
      "const": "NONE"
    },
    "domain_fixed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_entry_state": {
          "const": "REVOKED"
        }
      },
      "required": [
        "source_entry_state"
      ]
    },
    "outside_table_rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "const": "SRTT15-R00"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "const": "NOT_A_REPLACEMENT_BRANCH"
        },
        "source_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "rule_id",
        "predicate",
        "result",
        "source_trace"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^SRTT15-R(?:0[1-9]|1[01])$"
          },
          "precedence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 11
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "SEMANTIC_SCOPE_REVOKED",
              "SEMANTIC_SCOPE_PERMISSION_REEVALUATION_REQUIRED",
              "MAPPING_NOT_APPLICABLE",
              "REPLACEMENT_ELIGIBLE",
              "SEMANTIC_SCOPE_REPLACEMENT_INVALID"
            ]
          },
          "source_trace": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "rule_id",
          "precedence",
          "predicate",
          "result",
          "source_trace"
        ]
      }
    }
  },
  "required": [
    "schema",
    "status",
    "authority_effect",
    "domain_fixed",
    "outside_table_rule",
    "rules"
  ],
  "x-governance-source": [
    "NORM-027"
  ],
  "x-validator-invariants": [
    "rules contain exactly one each of SRTT15-R01..SRTT15-R11",
    "precedence values are exactly the unique contiguous set 1..11",
    "outside_table_rule is exactly SRTT15-R00 and is not part of table precedence"
  ]
}
