{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnosis.schema.json",
  "title": "Governed Failure Diagnosis",
  "type": "object",
  "required": ["primary_failure_class", "contributing_failure_classes", "authorized_artifact_classes", "requirement_resolution_required", "evidence_refs"],
  "properties": {
    "primary_failure_class": {
      "enum": ["CODE DEFECT", "FIXTURE-DATA DEFECT", "TEST DEFECT", "ENVIRONMENT-TOOLING DEFECT", "REQUIREMENT UNRESOLVED"]
    },
    "contributing_failure_classes": {
      "type": "array",
      "items": {
        "enum": ["CODE DEFECT", "FIXTURE-DATA DEFECT", "TEST DEFECT", "ENVIRONMENT-TOOLING DEFECT", "REQUIREMENT UNRESOLVED"]
      },
      "uniqueItems": true
    },
    "authorized_artifact_classes": {
      "type": "array",
      "items": {
        "enum": ["production_code", "fixtures", "seed_data", "test_data", "tests", "test_harness", "ci", "tooling", "environment_config", "build_config"]
      },
      "uniqueItems": true
    },
    "requirement_resolution_required": {"type": "boolean"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
