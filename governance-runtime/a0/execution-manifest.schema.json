{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setugo.local/schemas/a0-execution-manifest-v1.json",
  "title": "A0 Execution Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "repository",
    "authoritative_source_sha",
    "candidate_sha",
    "checker_sha",
    "policy_id",
    "policy_version",
    "policy_hash",
    "required_checks",
    "required_review_type",
    "authority_required",
    "environment",
    "artifact_digest",
    "known_reds",
    "open_findings",
    "next_action"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "authoritative_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checker_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_review_type": {"enum": ["NONE", "MANUAL_INDEPENDENT_REVIEW"]},
    "authority_required": {"type": "boolean"},
    "environment": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "known_reds": {"type": "array"},
    "open_findings": {"type": "array"},
    "next_action": {"type": "string", "minLength": 1}
  }
}
